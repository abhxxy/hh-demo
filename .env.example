# Home & Hill demo — every variable the app reads.
# Copy to .env for local runs. In Coolify, set these as environment variables.
# NEVER commit a real .env — all values below are placeholders.

# Port the app listens on (Coolify sets this; default 3000).
PORT=3000

# Public base URL of this deployment — used for portal links, Mollie
# redirect/webhook URLs and Twilio signature validation.
PUBLIC_BASE_URL=https://hh-demo.apps.autozenixai.com

# SQLite database file. In Docker this is the persistent volume (/data).
# Locally, use a file in the repo, e.g. file:./dev.db
DATABASE_URL=file:/data/demo.db

# Directory for uploaded ID photos. Defaults to /data/uploads.
# Locally you can set e.g. UPLOADS_DIR=./uploads
UPLOADS_DIR=/data/uploads

# Twilio — WhatsApp + SMS. SID + auth token from the Twilio console.
# The auth token also validates the X-Twilio-Signature header on webhooks.
# If both are unset, outbound WhatsApp/SMS is skipped (logged + shown in the
# dashboard) and webhook signature validation is skipped with a warning.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# WhatsApp sender number (Twilio, live and working). Include the whatsapp: prefix.
TWILIO_WHATSAPP_FROM=whatsapp:+32460201874

# Mollie — test mode API key (starts with test_). Used for the registration
# payment (tourist tax + deposit) and all extra payments.
# If unset, the portal shows a clear notice and offers a test-mode bypass so
# the demo still runs end to end.
MOLLIE_API_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LLM for the guest chat — provider openai or anthropic, API key and model.
# If unset, the chat uses a built-in rule-based guide (same live prices and
# availability) and says so in the portal.
LLM_PROVIDER=openai
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=gpt-4o-mini

# Staff dashboard password. If unset, /admin stays locked.
ADMIN_PASSWORD=choose-a-strong-password

# Hostify — optional. When unset the mock adapter (local DB) is used.
# When set, the RealHostifyAdapter stub is used (TODOs inside; it currently
# delegates to the mock so the demo keeps working).
HOSTIFY_API_KEY=
